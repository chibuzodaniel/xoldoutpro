// XOLDOUT — Prisma schema
// Source of truth for scope/invariants: xoldout-prd.md (repo root)
// Non-negotiable invariants (PRD §15):
//   - money is a ledger (WalletLedgerEntry), never a mutable balance column
//   - Product is polymorphic from day one, even though only Release exists in the MVP
//   - Entitlement is the source of truth for access, never Order
//   - StockPolicy is separate from Product and carries the sold-out timestamp

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Accounts ────────────────────────────────────────────────────────────
// Auth (password/Google) is handled by Firebase Auth. This row is created
// on first sign-in and mirrors the Firebase UID; no password is stored here.

model User {
  id                          String                  @id @default(cuid())
  firebaseUid                 String                  @unique
  email                       String                  @unique
  handle                      String                  @unique
  displayName                 String
  bio                         String?
  avatarUrl                   String?
  coverUrl                    String?
  tags                        String[]                @default([])
  socialLinks                 Json                    @default("[]") // [{ platform: "Instagram", url: "https://instagram.com/..." }, ...]
  // Profile sections (v2, design/v2-prototype): what visitors see on /u/<handle> —
  // { links, products, posts, library, location } booleans, see lib/profile/sections.ts.
  profileSections             Json                    @default("{}")
  profileLocation             String?
  // Defaults on for new signups (onboarding calls enablePush() once the
  // profile step completes, which is what actually requests the browser's
  // notification permission — this column alone is just the stored
  // preference). Existing users who signed up before this default flipped
  // keep whatever they'd already set; the toggle in Edit Profile still lets
  // anyone turn it off.
  pushEnabled                 Boolean                 @default(true)
  fcmTokens                   String[]                @default([]) // Firebase Cloud Messaging push tokens
  // Drives the in-app unread badge on the Socials nav tab (distinct from
  // push — this counts activity while the app itself is open) — null until
  // the user's first-ever Socials visit, treated as "everything" from then on.
  socialsLastSeenAt           DateTime?
  isModerator                 Boolean                 @default(false) // internal staff flag (PRD §3) — set directly in the DB, no self-serve UI
  // A super-moderator can additionally promote/demote other moderators from
  // the moderation dashboard (ManageModeratorsPanel) — the first one still
  // has to be set directly in the DB, same as isModerator itself, but from
  // there on out further moderators can be assigned/removed through the UI.
  isSuperModerator            Boolean                 @default(false)
  // Display-currency preference (lib/currency.ts's COUNTRIES code, e.g.
  // "GH"). Null = auto-detect from the request's geo-IP country. Display
  // only — every charge is still in NGN via Bachs.
  displayCountry              String?
  // Master "has a checkmark" flag — unchanged from its original PRD §12/§18
  // meaning and still moderator-togglable directly (POST /api/admin/verify)
  // for backward compatibility with every existing <VerifiedBadge> call
  // site. The verification system below is additive: approving any
  // VerificationApplication also sets this true (never unsets it — a
  // suspension/revocation clears verificationBadges but leaves this alone,
  // since other things, like the old moderator toggle, may still want it
  // on) and records which specific badge(s) were actually granted.
  isVerified                  Boolean                 @default(false)
  // Specific badges actually granted through VerificationApplication
  // approvals — distinct from isVerified so the UI can show e.g. "Seller
  // Verified" instead of just a bare checkmark. A plain array (matching
  // `tags`' convention elsewhere on this model) rather than a join table:
  // membership only ever needs "is type X currently granted," never its
  // own per-badge relations.
  verificationBadges          VerificationBadgeType[] @default([])
  // Set the first time the 50-valid-sales milestone notification/modal is
  // shown, so it doesn't re-trigger on every visit — see
  // lib/verification/eligibility.ts.
  salesMilestoneNotifiedAt    DateTime?
  createdAt                   DateTime                @default(now())
  // Defaults on for new signups, same as pushEnabled — user can turn it off
  // from the profile toggle. Weekly/monthly/yearly best-seller digest emails
  // (lib/email.ts sendDigestEmail, cron at /api/internal/send-digests).
  // Existing users' values are untouched by this default (Prisma column
  // defaults only apply to new rows) — only new signups start opted in.
  emailDigestSubscribed       Boolean                 @default(true)
  // Lets a signed-out recipient unsubscribe straight from the email footer
  // without an auth flow — a per-user secret, not the user's own id (which
  // would let anyone unsubscribe anyone by guessing/scraping ids). Optional
  // + lazily generated (getUnsubscribeToken in lib/email.ts) rather than a
  // Prisma-level default: db push can't backfill a required unique default
  // onto existing rows in one step, and every user needs a digest sent to
  // them at least once before the token is ever actually used anyway.
  unsubscribeToken            String?                 @unique
  // Soft delete: set by DELETE /api/me once the user confirms via the
  // "type DELETE <handle>" flow (components/profile/DeleteAccountSheet).
  // Real user rows are never hard-deleted — nothing in the schema cascades
  // off User, so a row with orders/payouts/products attached couldn't be
  // dropped anyway without destroying financial history. Deletion instead
  // scrubs PII (email/handle/displayName/avatar/bio/tags/socialLinks) and
  // disables the Firebase Auth account; requireUser() rejects any request
  // once this is set, even for a still-unexpired ID token.
  deletedAt                   DateTime?
  // Set on a guest checkout's placeholder row (explicit ask, 2026-10-15:
  // the guest's account should only exist once they've actually paid). An
  // Order needs a buyer row, so a brand-new guest email gets one at
  // checkout — but with a placeholder firebaseUid/handle, no Firebase login,
  // no email, and hidden from every listing. lib/commerce/guestCheckout.ts's
  // activatePendingGuest turns it into a real account when payment succeeds
  // (and clears this); an abandoned checkout leaves it invisible.
  pendingGuestAt              DateTime?
  // Set the first time this user publishes a beat and checks the
  // ownership/producer-agreement box (POST /api/beats) — never re-asked
  // after that, unlike Beat.ownershipConfirmedAt below, which is per-beat.
  producerAgreementAcceptedAt DateTime?

  // ─── Creator monetization plan (DECISIONS.md) ─────────────────────────
  // Null until first chosen — lib/commerce/creatorPlans.ts's
  // assertCanPublish() blocks publishing until it's set. Switching between
  // UNLIMITED/BUYER_PAYS_FEE is free/instant; switching into/renewing
  // LIMITED costs PlatformSettings.limitedPlanFeeKobo (wallet-or-Bachs, same
  // pattern as a Billboard purchase — lib/commerce/billboards.ts).
  creatorPlan            CreatorPlan?
  // LIMITED-only: resettable counter, reset to 0 by every successful
  // join/renewal payment so a fresh cycle always starts at
  // PlatformSettings.limitedPlanUploadCap uploads. Explicit ask,
  // 2026-09-22: sales are unlimited on this plan — renewal is triggered
  // only by hitting the upload limit, never by a sales count (there is no
  // sales cap at all). Needs an explicit counter (not a live product count)
  // specifically because renewal must grant fresh capacity without
  // deleting anything already posted.
  limitedUploadsUsed     Int          @default(0)
  limitedPlanActivatedAt DateTime?
  // BUYER_PAYS_FEE-only: additive, never reset — assertCanPublish() compares
  // a LIVE product count against buyerPaysFeeUploadCap + this, so no
  // separate "uploads used" counter is needed (unlike LIMITED above, this
  // cap never resets, it only ever grows via a slot-pack purchase).
  buyerPaysFeeBonusSlots Int          @default(0)

  // ─── Ambassador program ───────────────────────────────────────────────
  // Platform-wide referral role (not tied to any one creator — see
  // AmbassadorApplication below). isAmbassador flips true on approval;
  // ambassadorCode is lazily generated at that same moment (same
  // lazy-generation idea as unsubscribeToken above) and used in
  // `?ref=<code>` signup links. referredByAmbassadorId is set once, at
  // this user's own first-ever sign-in, if they arrived via such a link —
  // never reassigned after that (first-touch attribution).
  isAmbassador           Boolean @default(false)
  ambassadorCode         String? @unique
  referredByAmbassadorId String?
  referredByAmbassador   User?   @relation("AmbassadorReferrals", fields: [referredByAmbassadorId], references: [id])
  referredUsers          User[]  @relation("AmbassadorReferrals")

  ambassadorApplications         AmbassadorApplication[] @relation("AmbassadorApplicant")
  ambassadorApplicationsReviewed AmbassadorApplication[] @relation("AmbassadorReviewer")

  payoutAccounts PayoutAccount[]
  ledgerEntries  WalletLedgerEntry[]
  payouts        Payout[]
  billboards     Billboard[]
  products       Product[]
  entitlements   Entitlement[]
  orders         Order[]
  reports        Report[]            @relation("ReportsFiled")
  reportsAgainst Report[]            @relation("ReportsOnProfile")
  notifications  Notification[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  events Event[]

  posts     Post[]     @relation("PostsAuthored")
  postLikes PostLike[]
  comments  Comment[]
  pollVotes PollVote[]

  songComments     SongComment[]
  songCommentVotes SongCommentVote[]
  commentVotes     CommentVote[]

  collections Collection[]

  giftsSent Gift[] @relation("GiftsSent")

  featuredOn            ReleaseCollaborator[] @relation("CollabArtist")
  collabsInvitedByMe    ReleaseCollaborator[] @relation("CollabInviter")
  tipsReceived          Order[]               @relation("TipsReceived")
  // Catalog subscriptions (v2, design/v2-prototype, 2026-11-09): an artist's
  // plans, the artists this user subscribes to, and who subscribes to them.
  subscriptionPlans     SubscriptionPlan[]    @relation("SubscriptionPlans")
  catalogSubscriptions  CatalogSubscription[] @relation("Subscriber")
  catalogSubscribers    CatalogSubscription[] @relation("SubscribedCreator")
  // Whether this artist currently offers a catalog subscription.
  catalogSubscriptionOn Boolean               @default(false)
  productLikes          ProductLike[]
  giftsClaimed          Gift[]                @relation("GiftsClaimed")

  groupsCreated FanbaseGroup[]
  memberships   Membership[]
  joinRequests  JoinRequest[]

  trackPlays       TrackPlay[] @relation("TrackPlaysByUser")
  trackPlaysOfMine TrackPlay[] @relation("TrackPlaysOfCreator")

  verificationApplications VerificationApplication[] @relation("VerificationApplicant")
  verificationReviewed     VerificationApplication[] @relation("VerificationReviewer")
  verificationAuditActions VerificationAuditLog[]    @relation("VerificationAuditActor")

  moderatorOtpCodes ModeratorOtpCode[]

  eventPromoterRoles EventPromoter[]

  liveSessions             LiveSession[]
  liveGiftsSent            LiveGift[]
  liveGiftsReceived        LiveGift[]                @relation("LiveGiftsReceived")
  battlesHosted            LiveBattle[]
  battleEntries            LiveBattleCompetitor[]
  battleVotes              LiveBattleVote[]
  battleTurnVotes          LiveBattleTurnVote[]
  battleInvites            LiveBattleInvite[]
  liveAccessGrants         LiveAccessGrant[]
  liveRequestsSent         LiveRequest[]
  liveReminders            LiveReminder[]
  liveModeratorOf          LiveModerator[]
  liveStageRequests        LiveStageRequest[]
  liveGuestAlerts          LiveGuestAlert[]
  conversationParticipants ConversationParticipant[]
  directMessagesSent       DirectMessage[]
  blocksMade               UserBlock[]               @relation("BlocksMade")
  blocksReceived           UserBlock[]               @relation("BlocksReceived")
  coinLedgerEntries        CoinLedgerEntry[]
  xgEarnings               XgEarning[]
  eventLineups             EventLineupEntry[]        @relation("EventLineups")
}

model PayoutAccount {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String // returned by the processor's account-resolve call, must match at add-time
  isDefault     Boolean   @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  // Bachs requires a registered "payout destination" to pay out to, unlike
  // Flutterwave's flat per-call transfer API (lib/bachs.ts) — set when this
  // account is added. A row from before the Bachs payout switch has neither
  // and can't withdraw until the creator re-adds the bank account.
  payoutDestinationId     String?
  payoutDestinationUsable Boolean @default(false)

  payouts Payout[]

  @@index([userId])
}

model Follow {
  followerId String
  followedId String
  createdAt  DateTime @default(now())

  follower User @relation("Following", fields: [followerId], references: [id])
  followed User @relation("Followers", fields: [followedId], references: [id])

  @@id([followerId, followedId])
  @@index([followedId])
}

// One row per track/beat play start (recorded from the audio-url routes,
// which already run once per PlayerProvider.play() call) — feeds the
// Socials "suggested" ranking's "creators you play often" signal. Not a
// full listening-history feature (no duration/completion tracking), just
// enough signal to rank creators by play frequency.
model TrackPlay {
  id        String   @id @default(cuid())
  userId    String
  creatorId String
  // Nullable, and only ever set for an *entitled* (owned) play — a signed-in
  // visitor previewing a track they don't own still logs a row here (for the
  // Socials "creators you play often" ranking, which predates this field and
  // stays creatorId-only on purpose), but productId is left null for that
  // case so Heavy Rotation only ever counts real plays of things a fan
  // actually bought, never previews.
  productId String?
  createdAt DateTime @default(now())

  user    User @relation("TrackPlaysByUser", fields: [userId], references: [id])
  creator User @relation("TrackPlaysOfCreator", fields: [creatorId], references: [id])

  @@index([userId, createdAt])
  @@index([creatorId])
  @@index([userId, productId])
}

enum DownloadKind {
  OFFLINE // saved into the app's encrypted offline store (web IndexedDB / mobile file system)
  FILE // the real tagged master file (?download=1)
}

// Explicit ask, 2026-10-15: a seller (and moderators) can see, per buyer,
// whether a song was downloaded. Offline saves live only on the buyer's
// device, so the audio-url routes record them here when the client asks for
// the file with ?offline=1 (or ?download=1 for a real file download). One
// row per buyer/product/kind — count/lastAt track repeats. Removing an
// offline copy is never reported back, so this means "has downloaded", not
// "still has it".
model ProductDownload {
  id        String       @id @default(cuid())
  userId    String
  productId String
  kind      DownloadKind
  count     Int          @default(1)
  firstAt   DateTime     @default(now())
  lastAt    DateTime     @default(now())

  @@unique([userId, productId, kind])
  @@index([productId])
}

// ─── Fanbase: announcements (PRD §11 MVP) and groups (PRD §11 Phase 2) ─
// A Post with groupId = null is a creator announcement reaching followers
// (MVP). A Post with groupId set is a post inside that FanbaseGroup, subject
// to the group's postPermission — who may author one is enforced at the API
// layer, not by this model, the same way Report reasons are.

model Post {
  id                String            @id @default(cuid())
  authorId          String
  author            User              @relation("PostsAuthored", fields: [authorId], references: [id])
  groupId           String?
  group             FanbaseGroup?     @relation(fields: [groupId], references: [id])
  replyToId         String? // group chat quote-reply (image9 reference) — null for MVP announcement posts
  // Community channel (v2). Null = the community's General chat (every
  // message from before channels existed, and the mobile app's group chat).
  channelId         String?
  channel           CommunityChannel? @relation(fields: [channelId], references: [id])
  replyTo           Post?             @relation("PostReplies", fields: [replyToId], references: [id])
  body              String
  imageUrl          String?
  createdAt         DateTime          @default(now())
  // Socials v2 (design/v2-prototype): who can see it, reposts and an
  // attached product/event. "EVERYONE" | "FOLLOWERS". A repost is its own
  // Post row by the reposter (body empty) pointing at the original; the
  // mobile app's feed leaves reposts out (it doesn't ask for ?v=2).
  audience          String            @default("EVERYONE")
  repostOfId        String?
  repostOf          Post?             @relation("Reposts", fields: [repostOfId], references: [id])
  reposts           Post[]            @relation("Reposts")
  attachedProductId String?
  attachedProduct   Product?          @relation("PostAttachments", fields: [attachedProductId], references: [id])
  attachedEventId   String?
  attachedEvent     Event?            @relation("PostEventAttachments", fields: [attachedEventId], references: [id])

  likes    PostLike[]
  comments Comment[]
  poll     Poll?
  reports  Report[]   @relation("ReportsOnPost")
  replies  Post[]     @relation("PostReplies")

  @@unique([authorId, repostOfId])
  @@index([authorId, createdAt])
  @@index([groupId, createdAt])
  @@index([repostOfId])
  @@index([channelId, createdAt])
}

// Flat, not threaded — Phase 2 scope is "member participation," not a full
// nested comment tree.
model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
  // YouTube-style Socials comments (explicit ask, 2026-11-11), same as song
  // comments: one level of replies, likes kept as a counter. Additive —
  // older comments are top-level with 0 likes.
  parentId   String?
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("CommentReplies")
  likeCount  Int           @default(0)
  replyCount Int           @default(0)
  votes      CommentVote[]

  @@index([postId, createdAt])
  @@index([postId, parentId, likeCount])
  @@index([parentId, createdAt])
}

model CommentVote {
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  value     Int // 1 like, -1 dislike
  createdAt DateTime @default(now())

  @@id([commentId, userId])
  @@index([userId])
}

// One poll per post, one vote per user. options[i] is what PollVote.optionIndex
// indexes into — simple enough for "proportional result bars" (PRD §11) without
// a separate PollOption table.
model Poll {
  postId  String   @id
  post    Post     @relation(fields: [postId], references: [id])
  options String[]

  votes PollVote[]
}

model PollVote {
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [postId])
  user User @relation(fields: [userId], references: [id])

  @@id([pollId, userId])
}

enum GroupVisibility {
  OPEN
  REQUEST_TO_JOIN
}

enum GroupPostPermission {
  CREATOR_ONLY
  ADMINS
  ALL_MEMBERS
}

// Default ALL_MEMBERS — a new Fanbase is open for everyone to post/message in
// until the creator/an admin locks it down to ADMINS or CREATOR_ONLY via the
// Manage Group sheet. (Supersedes the original PRD §11 CREATOR_ONLY default;
// product call 2026-08-26 to favor an open-by-default group over pre-opting
// owners into moderation load.)
model FanbaseGroup {
  id             String              @id @default(cuid())
  creatorId      String
  creator        User                @relation(fields: [creatorId], references: [id])
  name           String
  description    String?
  coverImageUrl  String?
  visibility     GroupVisibility     @default(REQUEST_TO_JOIN)
  postPermission GroupPostPermission @default(ALL_MEMBERS)
  createdAt      DateTime            @default(now())

  // Verification criteria are undecided (same PRD §18 gap as User.isVerified)
  // — deliberately a blunt moderator-toggled flag, not a review workflow with
  // evidence. Unlike User verification, a group owner can self-serve *request*
  // one (verificationRequestedAt), since "apply for verification" was an
  // explicit ask; a moderator still has to actually flip isVerified.
  isVerified              Boolean                @default(false)
  verificationRequestedAt DateTime?
  // Set alongside isVerified when a FANBASE-type VerificationApplication is
  // approved — distinguishes an officially-authorized fanbase from one
  // just recognized as a genuine community without proof of authorization
  // (spec: "do not automatically assume every fanbase is officially
  // endorsed"). Null until an application targeting this group is approved.
  verificationBadgeType   VerificationBadgeType?

  memberships              Membership[]
  joinRequests             JoinRequest[]
  posts                    Post[]
  verificationApplications VerificationApplication[]

  // ─── Communities (v2, design/v2-prototype, 2026-11-09) ──────────────────
  // Every Fanbase is a Community (explicit ask: upgrade, don't duplicate).
  // coverImageUrl stays the square logo; bannerUrl is the wide cover. A
  // community's original chat (Post.channelId null) is its "General"
  // channel; CommunityChannel adds Announcements and topic channels.
  handle      String?            @unique
  category    String?
  bannerUrl   String?
  location    String?
  rules       String?
  inviteCode  String?            @unique
  isFeatured  Boolean            @default(false)
  // Suspended by XOLDOUT moderators (v2 part 3): hidden from the directory,
  // no joining, posting or renewals; members keep their rows.
  suspendedAt DateTime?
  reports     Report[]           @relation("ReportsOnCommunity")
  channels    CommunityChannel[]
  plans       MembershipPlan[]

  @@index([creatorId])
}

// A channel inside a community. kind ANNOUNCEMENTS: only admins post;
// DISCUSSION: members post (subject to the group's postPermission).
// planIds empty = every active member; otherwise only members on one of
// those plans (plus admins) can open it.
model CommunityChannel {
  id        String       @id @default(cuid())
  groupId   String
  group     FanbaseGroup @relation(fields: [groupId], references: [id])
  name      String
  kind      String       @default("DISCUSSION") // "ANNOUNCEMENTS" | "DISCUSSION"
  planIds   String[]     @default([])
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  posts     Post[]

  @@index([groupId, order])
}

// A way to join a community. priceKobo 0 = free. cycle ONE_TIME never
// expires; MONTHLY/YEARLY memberships run to Membership.expiresAt and renew
// like catalog subscriptions (lib/communities/renewals.ts). capacity null =
// unlimited. requiresApproval: an admin approves the application first, then
// (for a paid plan) the fan pays.
model MembershipPlan {
  id               String       @id @default(cuid())
  groupId          String
  group            FanbaseGroup @relation(fields: [groupId], references: [id])
  name             String
  description      String?
  priceKobo        Int          @default(0)
  cycle            String       @default("MONTHLY") // "MONTHLY" | "YEARLY" | "ONE_TIME"
  benefits         String[]     @default([])
  capacity         Int?
  requiresApproval Boolean      @default(false)
  order            Int          @default(0)
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())

  @@index([groupId])
}

enum MembershipRole {
  MEMBER
  ADMIN
}

model Membership {
  groupId           String
  userId            String
  role              MembershipRole @default(MEMBER)
  joinedAt          DateTime       @default(now())
  // Null until the member ever opens the group's chat — the Fanbase list's
  // unread count is posts newer than max(lastReadAt, joinedAt), bumped to
  // now() whenever GET /api/groups/[id]/posts is called for this membership.
  lastReadAt        DateTime?
  // Community plans (v2): which plan this member joined on, and — for a
  // MONTHLY/YEARLY paid plan — when it lapses (null = never). Same auto-
  // renew/reminder/saved-card fields as CatalogSubscription.
  planId            String?
  expiresAt         DateTime?
  autoRenew         Boolean        @default(true)
  renewalNotifiedAt DateTime?
  cardToken         String?
  cardProcessor     String?
  cardEmail         String?
  // Membership card (v2 part 2): the code in its QR, made on first view; an
  // organizer scanning it is always checked against this row, never the image.
  cardCode          String?        @unique
  // Suspended by an admin: keeps the row (and paid time) but no access.
  suspendedAt       DateTime?

  group FanbaseGroup @relation(fields: [groupId], references: [id])
  user  User         @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
  @@index([userId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model JoinRequest {
  id        String            @id @default(cuid())
  groupId   String
  userId    String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  // The plan applied for (v2 communities); null for a plain Fanbase request.
  planId    String?

  group FanbaseGroup @relation(fields: [groupId], references: [id])
  user  User         @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([groupId, status])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([postId, userId])
  @@index([userId])
}

// ─── Money: ledger, not a balance column ───────────────────────────────
// Available balance  = SUM(amountKobo) WHERE userId = ? AND status = AVAILABLE
// Pending balance    = SUM(amountKobo) WHERE userId = ? AND status = PENDING
// Every credit/debit/fee/refund/payout is its own immutable row.

enum LedgerKind {
  SALE_CREDIT
  COMMISSION_FEE
  REFUND_DEBIT
  PAYOUT_DEBIT
  // Automatic, per-sale credit to an ambassador when the buyer was one of
  // their referrals — carved out of the platform's own commission share,
  // never the seller's (lib/commerce/ledger.ts's recordAmbassadorCommission).
  AMBASSADOR_COMMISSION
  // Ticket promoter split (per-event, distinct from the ambassador program):
  // PROMOTER_CREDIT is the promoter's automatic cut, PROMOTER_FEE is the
  // matching debit carved out of the *seller's* own net on that same order.
  PROMOTER_CREDIT
  PROMOTER_FEE
  // Wallet-funded Billboard purchase (lib/commerce/billboards.ts) — a debit
  // like PAYOUT_DEBIT, not tied to any Order.
  BILLBOARD_FEE
  // Reverses a BILLBOARD_FEE when a moderator rejects a billboard
  // (lib/commerce/billboards.ts's rejectBillboard) — a Bachs-paid billboard
  // is refunded via a real Bachs refund instead, not this.
  BILLBOARD_REFUND
  // Wallet-funded creator-plan charge (lib/commerce/creatorPlans.ts) — same
  // shape as BILLBOARD_FEE, covers both a LIMITED join/renewal and a
  // BUYER_PAYS_FEE slot-pack purchase (Payment.creatorPlanPaymentKind tells
  // the two apart at the Bachs-webhook level; the ledger doesn't need to).
  CREATOR_PLAN_FEE
  // Xoldout Live creator earnings (lib/live/gifts.ts) — the seller side of
  // an XG spend; CoinLedgerEntry's GIFT_DEBIT/PAID_ACCESS_DEBIT/
  // PAID_REQUEST_DEBIT is the matching buyer side, on the separate XG
  // ledger. Real Naira, withdrawable like any other sale.
  LIVE_GIFT_CREDIT
  LIVE_ACCESS_CREDIT
  LIVE_REQUEST_CREDIT
  // Conversion of a creator's earned XG (XgEarning) into Naira once held —
  // replaces the instant LIVE_*_CREDIT rows above for every XG received
  // from 2026-10-04 on (those kinds stay only for historical rows). One row
  // per creator per conversion run; see lib/live/xgEarnings.ts.
  XG_EARNINGS_PAYOUT
  // XG pack bought with wallet money instead of a Bachs checkout
  // (explicit ask, 2026-10-08) — a debit, like BILLBOARD_FEE.
  XG_PURCHASE
  // A buyer's refund paid into their xoldOut wallet because the processor
  // refused to reverse the charge ("Refunds are not supported for this
  // charge" — explicit choice, 2026-10-15). Credits the *buyer*; the
  // seller-side reversal is still the order's REFUND_DEBIT.
  REFUND_CREDIT
  // Fan tips (explicit ask, 2026-11-06): TIP_CREDIT is the tip paid to the
  // artist, TIP_COMMISSION_FEE the platform's cut of it
  // (PlatformSettings.commissionTipPercent). Kept apart from SALE_CREDIT/
  // COMMISSION_FEE so a tip never counts as a sale. Written by
  // lib/commerce/ledger.ts's recordTip, reversed by recordRefund.
  TIP_CREDIT
  TIP_COMMISSION_FEE
  // Featured-artist royalty split (explicit ask, 2026-11-06): on each sale
  // of a release with an ACCEPTED ROYALTY_SPLIT collaborator, the main
  // artist's net (after platform commission) is split — ROYALTY_SPLIT_FEE
  // debits the main artist, ROYALTY_SPLIT_CREDIT credits the featured
  // artist. Same pairing as PROMOTER_FEE/PROMOTER_CREDIT; reversed by
  // recordRefund.
  ROYALTY_SPLIT_FEE
  ROYALTY_SPLIT_CREDIT
  // Catalog subscriptions (v2, 2026-11-09): the subscription payment paid to
  // the artist and the platform's cut (PlatformSettings.
  // commissionSubscriptionPercent). Never counted as a sale. Written by
  // lib/subscriptions/payments.ts; WalletLedgerEntry.subscriptionId says which.
  SUBSCRIPTION_CREDIT
  SUBSCRIPTION_COMMISSION_FEE
  // Paid community memberships (v2, 2026-11-09): paid to the community's
  // owner, minus PlatformSettings.commissionMembershipPercent.
  MEMBERSHIP_CREDIT
  MEMBERSHIP_COMMISSION_FEE
}

// Three creator-selectable monetization plans (DECISIONS.md) — see
// lib/commerce/creatorPlans.ts and lib/commerce/ledger.ts's recordSale
// (Order.commissionOverrideKobo) for how each actually changes the money
// split. Null on User.creatorPlan means "not chosen yet."
enum CreatorPlan {
  // Today's model: platform commission (PlatformSettings.commission*Percent)
  // deducted from the seller's own proceeds. No upload cap.
  UNLIMITED
  // Commission (PlatformSettings.buyerPaysFeePercent, flat) added on top of
  // the price at checkout and paid by the buyer as a displayed "service
  // charge" — seller keeps 100% of their listed price. Capped at
  // buyerPaysFeeUploadCap + User.buyerPaysFeeBonusSlots live listings.
  BUYER_PAYS_FEE
  // No commission at all — seller keeps 100%, unlimited sales. Costs
  // PlatformSettings.limitedPlanFeeKobo to join/renew, capped at
  // limitedPlanUploadCap uploads per cycle (User.limitedUploadsUsed, reset
  // on every renewal) — renewal is triggered only by hitting that upload
  // limit, never by a sales count.
  LIMITED
}

enum LedgerStatus {
  PENDING
  AVAILABLE
}

model WalletLedgerEntry {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  amountKobo        Int // signed: credits positive, debits negative
  kind              LedgerKind
  status            LedgerStatus
  orderId           String?
  order             Order?       @relation(fields: [orderId], references: [id])
  payoutId          String?
  payout            Payout?      @relation(fields: [payoutId], references: [id])
  billboardId       String?
  billboard         Billboard?   @relation(fields: [billboardId], references: [id])
  createdAt         DateTime     @default(now())
  availableAt       DateTime? // set at creation = createdAt + settlement window; sweep flips PENDING->AVAILABLE at this time
  // Set on SUBSCRIPTION_CREDIT / SUBSCRIPTION_COMMISSION_FEE rows only.
  subscriptionId    String?
  // Set on MEMBERSHIP_CREDIT / MEMBERSHIP_COMMISSION_FEE rows only.
  membershipGroupId String?

  @@index([userId, status])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Payout {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amountKobo      Int
  feeKobo         Int // always 0 for now: platform absorbs the withdrawal fee (DECISIONS.md)
  netKobo         Int
  status          PayoutStatus  @default(PENDING)
  payoutAccountId String
  payoutAccount   PayoutAccount @relation(fields: [payoutAccountId], references: [id])
  processorRef    String?       @unique
  createdAt       DateTime      @default(now())

  ledgerEntries WalletLedgerEntry[]

  @@index([userId])
}

// ─── Products (polymorphic) ────────────────────────────────────────────
// Only RELEASE has an implemented subtype in the MVP. BEAT/EVENT/MERCH
// exist as enum members so the publish sheet and schema don't need a
// migration when Phase 2/3 land (PRD §15 requirement).

enum ProductType {
  RELEASE
  BEAT
  EVENT
  MERCH
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  DELETED
}

model Product {
  id             String        @id @default(cuid())
  creatorId      String
  creator        User          @relation(fields: [creatorId], references: [id])
  type           ProductType
  title          String
  description    String
  priceKobo      Int // 0 = free; free is first-class, not a discount
  // "Let fans pay anything" (RELEASE only, explicit ask 2026-11-06): the fan
  // picks the price at checkout and priceKobo is the minimum they may pay
  // (PAY_WHAT_YOU_WANT_MIN_KOBO, ₦500). OrderItem.priceKobo snapshots what
  // was actually paid.
  payWhatYouWant Boolean       @default(false)
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  publishedAt    DateTime?
  // One-time upgrade edit for listings published before 2026-11-12 (explicit
  // ask, 2026-11-11): set on the first name/price/cover/description save after
  // the normal window closed; that save opens a fresh 48h window (lib/editWindow.ts).
  upgradeEditAt  DateTime?
  deletedAt      DateTime?
  // How many Creative Add-ons (ProductAddOn) this item has — kept in step
  // by every add-on write so every browsing surface can show the E+ badge
  // from the product row alone, without a join or count per card.
  addOnCount     Int           @default(0)
  // Likes (v2 feed card heart, design/v2-prototype, 2026-11-09) — kept in step
  // by every like/unlike (ProductLike) so cards never count rows.
  likeCount      Int           @default(0)

  release              Release?
  beat                 Beat?
  ticketTier           TicketTier?
  merchItem            MerchItem?
  stockPolicy          StockPolicy?
  entitlements         Entitlement[]
  orderItems           OrderItem[]
  reports              Report[]              @relation("ReportsOnProduct")
  gifts                Gift[]
  pinnedInLiveSessions LiveSession[]
  billboards           Billboard[]
  addOns               ProductAddOn[]
  collaborators        ReleaseCollaborator[]
  merchVariants        MerchVariant[]
  beatLicenses         BeatLicense[]
  likes                ProductLike[]
  postAttachments      Post[]                @relation("PostAttachments")

  @@index([creatorId])
  @@index([status, type])
}

// ─── Featured artists & revenue sharing (explicit ask, 2026-11-06) ────────
// The main artist (Product.creatorId) tags other XOLDOUT artists on a release
// at upload. Each tag picks an arrangement:
//   ROYALTY_SPLIT — sharePercent of the main artist's net on every sale
//     (after platform commission) goes to the featured artist automatically,
//     via ROYALTY_SPLIT_FEE/ROYALTY_SPLIT_CREDIT ledger rows (recordSale).
//   CREDIT_ONLY — credited on the release and their profile; sharePercent 0,
//     the main artist keeps 100%.
// Nothing is official until the featured artist ACCEPTS: a PENDING tag shows
// only to the two parties, never publicly, and earns nothing. Splits apply to
// sales made after acceptance (never retroactive). The main artist's own
// share is 100 minus every ROYALTY_SPLIT tag's share, so the split always
// totals 100%. A tag is fixed once sent; the main artist can only withdraw
// one that's still PENDING.
enum CollabArrangement {
  ROYALTY_SPLIT
  CREDIT_ONLY
}

enum CollabStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ReleaseCollaborator {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  artistId     String
  artist       User              @relation("CollabArtist", fields: [artistId], references: [id])
  invitedById  String
  invitedBy    User              @relation("CollabInviter", fields: [invitedById], references: [id])
  arrangement  CollabArrangement
  sharePercent Int               @default(0)
  status       CollabStatus      @default(PENDING)
  createdAt    DateTime          @default(now())
  respondedAt  DateTime?

  @@unique([productId, artistId])
  @@index([artistId, status])
  @@index([productId, status])
}

// ─── Creative Add-ons (V1.2) ─────────────────────────────────────────────
// Bonus content an artist attaches to a release (explicit ask, 2026-10-21):
// music video, visualizer, exclusive artwork, wallpapers, lyrics, booklet,
// behind-the-scenes. Not a product of its own — buying the release is what
// unlocks it (lib/commerce/addOns.ts). Music only for now.
enum AddOnKind {
  MUSIC_VIDEO
  VISUALIZER
  ARTWORK
  WALLPAPER
  LYRICS
  BOOKLET
  BEHIND_THE_SCENES
  OTHER
}

// Exactly one of youtubeId / fileKey is set. YouTube is the preferred way to
// attach a video (no storage, plays instantly) but is watch-only and not
// truly exclusive; an uploaded file (≤100 MB, in R2 under addons/<creator>/)
// is only ever served to buyers through short-lived signed links, and is
// what "Download" / "Download All" bundle.
model ProductAddOn {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind        AddOnKind
  title       String
  description String?
  youtubeId   String?
  fileKey     String?
  fileName    String?
  contentType String?
  sizeBytes   Int?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([productId, order])
}

enum ReleaseType {
  SINGLE
  EP
  ALBUM
}

model Release {
  productId     String      @id
  product       Product     @relation(fields: [productId], references: [id])
  releaseType   ReleaseType
  artworkLadder Json // { "64":url, "256":url, "1024":url }
  // Music tab discovery (V1.2, explicit ask 2026-10-21): slugs from
  // lib/music/tags.ts. Required (1-3 genres) on new uploads; releases from
  // before this start empty and still show under All until tagged.
  genres        String[]    @default([])
  moods         String[]    @default([])

  tracks Track[]

  @@index([genres], type: Gin)
  @@index([moods], type: Gin)
}

model Track {
  id               String  @id @default(cuid())
  releaseId        String
  release          Release @relation(fields: [releaseId], references: [productId])
  order            Int
  title            String
  description      String?
  audioMasterUrl   String // original upload, retained for download entitlement
  audioStreamUrl   String? // transcoded full-length rendition; only ever served to an entitled listener
  previewAudioUrl  String? // real server-trimmed clip covering only [previewStartSec, previewEndSec) — the only thing a non-entitled request can ever receive. Null on rows published before this existed; those fall back to audioStreamUrl until backfilled (see /api/internal/backfill-preview-clips)
  waveformPeaksUrl String? // server-generated peak JSON; null until worker finishes
  previewStartSec  Float
  previewEndSec    Float
  durationSec      Float
  lyricsText       String?

  @@index([releaseId, order])
}

// ─── Song comments (explicit ask, 2026-11-04) ────────────────────────────
// YouTube-style comments under the player: top-level comments on one song
// plus one level of replies (a reply to a reply attaches to the same
// top-level comment, @-mentioning who it answers, as YouTube does).
// Keyed by the player's own ids: trackKind "track" → Track.id, "beat" →
// Beat.productId. productId is the owning Product (Release or Beat), kept so
// the creator check and notification link need no join. likeCount and
// replyCount are kept in step by every write so listing never counts rows.
model SongComment {
  id         String        @id @default(cuid())
  trackKind  String
  trackId    String
  productId  String
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  parentId   String?
  parent     SongComment?  @relation("SongCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    SongComment[] @relation("SongCommentReplies")
  body       String
  likeCount  Int           @default(0)
  replyCount Int           @default(0)
  createdAt  DateTime      @default(now())

  votes SongCommentVote[]

  @@index([trackKind, trackId, parentId, createdAt])
  @@index([trackKind, trackId, parentId, likeCount])
  @@index([parentId, createdAt])
  // Feed cards count comments per release/beat (v2, 2026-11-09).
  @@index([productId])
}

// value 1 = like, -1 = dislike. Like YouTube, only likes are ever shown as
// a number; a dislike is private to the person who cast it.
model SongCommentVote {
  commentId String
  comment   SongComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  value     Int
  createdAt DateTime    @default(now())

  @@id([commentId, userId])
  @@index([userId])
}

// A beat purchase grants a single flat license (buyout-style — full
// commercial rights forever, DECISIONS.md); no lease/exclusive tiers.
// Reuses the same audio pipeline as Track: previewAudioUrl (a real trimmed
// clip, not the full track) is what a non-buyer hears, audioMasterUrl is
// what presignDownload serves after buy.
model Beat {
  productId            String    @id
  product              Product   @relation(fields: [productId], references: [id])
  coverImageLadder     Json
  audioMasterUrl       String
  audioStreamUrl       String?
  previewAudioUrl      String? // see Track.previewAudioUrl's comment — same fallback story for pre-existing rows
  waveformPeaksUrl     String?
  previewStartSec      Float
  previewEndSec        Float
  durationSec          Float
  bpm                  Int?
  musicalKey           String?
  tags                 String[]  @default([])
  // Discover → Beats chips (v2, design/v2-prototype). Optional; older beats have none.
  genre                String?
  mood                 String?
  // Set at publish time once the producer checks the ownership/rights
  // confirmation box (POST /api/beats) — required per beat, unlike
  // User.producerAgreementAcceptedAt above, which is a one-time acceptance.
  ownershipConfirmedAt DateTime?
}

// StockPolicy is intentionally separate from Product: cap/sold/reserved
// mutate on every purchase attempt, Product does not. soldOutAt is what
// makes "time to sell out" reportable (PRD §13).
model StockPolicy {
  productId String    @id
  product   Product   @relation(fields: [productId], references: [id])
  cap       Int? // null = unlimited
  sold      Int       @default(0)
  reserved  Int       @default(0) // in-flight (payment-initiated, not yet confirmed) holds
  soldOutAt DateTime?
}

// Entitlement is the durable fact of access — never derived from Order,
// which can be refunded/split/gifted later without touching this table
// except via explicit revocation.
model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  createdAt DateTime  @default(now())
  revokedAt DateTime? // set only by a refund
  // Long-press "Pin" action (Library) — pinned items sort first. A
  // timestamp rather than a boolean, matching this schema's convention
  // elsewhere, so "most recently pinned first" is free without extra state.
  pinnedAt  DateTime?
  // "Remove from library" (explicit ask, 2026-11-11): hides the purchase from
  // the buyer's own library only. Not a refund; access and sales unchanged.
  hiddenAt  DateTime?

  checkIn         TicketCheckIn?
  collectionItems CollectionItem[]

  // Was @@unique([userId, productId]) — dropped so a ticket/merch group buy
  // (quantity > 1, OrderItem.quantity) can create one Entitlement row per
  // unit for the same user+product, each with its own TicketCheckIn where it
  // applies. RELEASE/BEAT stay effectively single-entitlement in practice —
  // enforced by the orders API's "already own this" guard, not by the DB —
  // since a digital single never had a reason to be bought twice.
  @@index([userId, productId])
}

// User-organised groupings of what they own (PRD §10 Phase 2) — a thin
// join table over Entitlement, not a copy of it. Deleting a Collection never
// touches the underlying entitlement/ownership.
model Collection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now())

  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  collectionId  String
  entitlementId String
  addedAt       DateTime @default(now())

  collection  Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entitlement Entitlement @relation(fields: [entitlementId], references: [id])

  @@id([collectionId, entitlementId])
}

// An Event is a parent listing (venue, date, cover image) grouping one or
// more TicketTiers. Deliberate deviation from the PRD's diagram (Event as a
// direct Product subtype): each *tier* is its own Product, so ticket sales
// reuse StockPolicy/Entitlement/reserveStock/recordSale exactly as-is instead
// of inventing a second stock/entitlement mechanism (DECISIONS.md).
model Event {
  id               String        @id @default(cuid())
  creatorId        String
  creator          User          @relation(fields: [creatorId], references: [id])
  title            String
  description      String
  coverImageLadder Json
  venue            String?
  isVirtual        Boolean       @default(false)
  // Discover → Events chips / "Near You" (v2, design/v2-prototype). Optional.
  eventType        String?
  city             String?
  startsAt         DateTime
  endsAt           DateTime?
  status           ProductStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  publishedAt      DateTime?
  deletedAt        DateTime?

  tiers           TicketTier[]
  reports         Report[]        @relation("ReportsOnEvent")
  promoters       EventPromoter[]
  billboards      Billboard[]
  postAttachments Post[]          @relation("PostEventAttachments")
  lineup          EventLineupEntry[]
  discounts       EventDiscount[]

  // Events marketplace (explicit ask, 2026-11-11). Promoters: anyone can
  // apply when open; the host pays them PERCENT of the ticket price actually
  // paid (promoter picks within min..max) or a FLAT amount per ticket — from
  // the host's share, independent of the platform fee.
  promotersOpen      Boolean @default(false)
  promoterPayType    String  @default("PERCENT") // "PERCENT" | "FLAT"
  promoterMinPercent Int     @default(5)
  promoterMaxPercent Int     @default(20)
  promoterFlatKobo   Int     @default(0)
  // Most tickets one buyer can get for this event across all orders (null = no limit).
  maxPerBuyer        Int?

  @@index([creatorId])
}

// Event discounts (2026-11-11): PERCENT or FLAT (kobo off each ticket); a
// code, or automatic (no code — early-bird offers). Optional window, usage
// limit (orders) and ticket types (empty = all). Checked and applied on the
// server at checkout (app/api/orders); the order snapshots what it got.
model EventDiscount {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id])
  name      String
  code      String? // stored upper-case; null = applies automatically
  kind      String // "PERCENT" | "FLAT"
  value     Int // percent (1-100) or kobo per ticket
  isEarlyBird Boolean @default(false)
  startsAt  DateTime?
  expiresAt DateTime?
  maxUses   Int?
  tierIds   String[]  @default([])
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  orders    Order[]

  @@unique([eventId, code])
  @@index([eventId])
}

// Event lineup (v2, design/v2-prototype): XOLDOUT accounts only, in the
// organiser's order. Each person is notified when added. Additive table.
model EventLineupEntry {
  eventId String
  event   Event    @relation(fields: [eventId], references: [id])
  userId  String
  user    User     @relation("EventLineups", fields: [userId], references: [id])
  order   Int
  addedAt DateTime @default(now())
  // 2026-11-11: role and invitation. Existing rows count as accepted; new
  // ones start PENDING until the artist accepts. Only ACCEPTED show publicly.
  role        String    @default("ARTIST") // HEADLINER | SUPPORTING | SPECIAL_GUEST | DJ | ARTIST
  status      String    @default("ACCEPTED") // PENDING | ACCEPTED | DECLINED
  respondedAt DateTime?

  @@id([eventId, userId])
  @@index([userId])
}

model TicketTier {
  productId String    @id
  product   Product   @relation(fields: [productId], references: [id])
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id])
  name      String // "Early Bird", "Regular", "VIP"
  order     Int
  pausedAt  DateTime? // creator hid it from sale; reversible any time (unlike TicketTier DELETE), existing tickets/entitlements untouched
  // Most of this ticket type one buyer can get across all orders (null = no limit).
  maxPerBuyer Int?

  @@index([eventId])
}

// One per Entitlement on an EVENT-type product. code is shown as a QR in the
// buyer's Library; checkedInAt is set once by the creator's scan endpoint.
model TicketCheckIn {
  entitlementId String      @id
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id])
  code          String      @unique @default(cuid())
  checkedInAt   DateTime?
  checkedInBy   String? // creatorId/staff userId who scanned
}

// Single-Product merch listing, no size/color variants in v1 (matches the
// reference screenshots; deliberate simplification — see DECISIONS.md).
model MerchItem {
  productId        String   @id
  product          Product  @relation(fields: [productId], references: [id])
  imageLadder      Json
  galleryImageUrls String[] @default([])
  shippingFeeKobo  Int      @default(0) // flat fee, creator-set at publish time; added to Product.priceKobo at checkout
  // Optional size guide text shown next to the size picker (v2, 2026-11-09).
  sizeGuide        String?
  // Discover → Merch chips (v2, design/v2-prototype). Optional.
  category         String?
}

// One like per account per product (v2 feed cards, 2026-11-09).
model ProductLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
}

// Beat license tiers (v2, design/v2-prototype, 2026-11-09). Optional — a beat
// with none sells under the single flat license in /legal/terms (as before).
// Each tier has its own price, formats and structured terms (lib/commerce/
// beatLicenses.ts). The buyer picks one and agrees to it at checkout; the
// tier's name and full terms are snapshotted on OrderItem so later edits
// never change what someone bought. Buying an exclusive tier closes the beat
// to further sales. Product.priceKobo holds the cheapest tier ("from ₦X").
model BeatLicense {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String
  priceKobo   Int
  formats     String[] @default([])
  isExclusive Boolean  @default(false)
  terms       Json
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  orderItems OrderItem[]

  @@index([productId, order])
}

// Merch sizes & colours (v2, design/v2-prototype, 2026-11-09). Optional — a
// merch listing with no variants works exactly as before. Each variant is a
// size and/or colour with its own optional stock, on top of the listing's
// overall StockPolicy (both are reserved/confirmed/released together —
// lib/commerce/variants.ts). Same price for every variant. The buyer's pick
// is snapshotted on OrderItem (variantId + variantLabel).
model MerchVariant {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  size      String?
  color     String?
  cap       Int? // null = no stock limit of its own
  sold      Int       @default(0)
  reserved  Int       @default(0)
  soldOutAt DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  orderItems OrderItem[]

  @@index([productId, order])
}

enum FulfillmentStatus {
  TO_SHIP
  SHIPPED
  DELIVERED
}

// Creator-shipped fulfilment (DECISIONS.md): platform only collects the
// address and payment; the creator ships and marks it fulfilled. No
// platform warehouse/inventory system.
model MerchOrderFulfillment {
  orderId         String            @id
  order           Order             @relation(fields: [orderId], references: [id])
  recipientName   String
  phone           String
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  country         String            @default("Nigeria")
  shippingFeeKobo Int               @default(0) // snapshot at checkout, independent of later fee edits on MerchItem
  status          FulfillmentStatus @default(TO_SHIP)
  shippedAt       DateTime?
  trackingInfo    String?
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model Order {
  id               String      @id @default(cuid())
  buyerId          String
  buyer            User        @relation(fields: [buyerId], references: [id])
  status           OrderStatus @default(PENDING)
  isGift           Boolean     @default(false) // routes the entitlement to a Gift instead of the buyer at confirm time
  createdAt        DateTime    @default(now())
  // Guest checkout by a brand-new email only (see User.pendingGuestAt): the
  // browser that started checkout holds this and shows it to GET
  // /api/orders/[id] from the return page — once the order is PAID that
  // returns a sign-in token for the freshly activated account.
  guestAccessToken String?     @unique

  // Ticket promoter split (EVENT only) — set at checkout time from a
  // `?promo=<code>` link (EventTierPicker), resolved against EventPromoter.
  // Null for every non-ticket order and for a ticket bought with no promoter
  // link. See lib/commerce/ledger.ts's recordSale for how this drives the
  // PROMOTER_FEE/PROMOTER_CREDIT split.
  promoterId String?
  promoter   EventPromoter? @relation(fields: [promoterId], references: [id])
  // Promoter's commission, fixed at checkout from the price actually paid
  // after discounts (2026-11-11). Null on older orders (legacy % of net).
  promoterCommissionKobo Int?
  // Event discount applied at checkout (2026-11-11): which one, and how much off in total.
  discountId   String?
  discount     EventDiscount? @relation(fields: [discountId], references: [id])
  discountKobo Int            @default(0)

  // Snapshotted at checkout time (app/api/orders/route.ts) from the
  // seller's CreatorPlan at that moment — same "lock in what was actually
  // charged" reasoning as OrderItem.priceKobo, since Payment.amountKobo is
  // also fixed at checkout and the two have to stay consistent even if the
  // seller's plan changes before the webhook confirms payment. Read back by
  // lib/commerce/confirmPayment.ts's finalizePayment and passed straight
  // through to recordSale's commissionOverrideKobo. Null = UNLIMITED (use
  // the live per-type rate, today's unchanged behavior); 0 = LIMITED (no
  // commission); the buyer's added service charge = BUYER_PAYS_FEE.
  commissionOverrideKobo Int?

  // Fan tips (explicit ask, 2026-11-06). tipKobo is the tip part of
  // Payment.amountKobo: added on top of a purchase at checkout, or the whole
  // amount when isTipOnly (the "Tip artist" button: no purchase; its one
  // OrderItem has quantity 0 so stock code and sales counts ignore it).
  // A tip never gets a service charge added; recordTip takes its own cut.
  tipKobo   Int     @default(0)
  isTipOnly Boolean @default(false)

  // Cart checkout (v2, 2026-11-09): orders paid together share this id with
  // their single Payment (Payment.checkoutGroupId), and amountKobo is this
  // order's own share of that payment — what its sale, refund and emails use.
  // Both null for every order paid on its own (Payment.amountKobo is its amount).
  checkoutGroupId String?
  amountKobo      Int?
  // Who a tip-only order pays (explicit ask, 2026-11-07: fans can tip an
  // artist from their profile without buying anything). Set on every
  // tip-only order: a profile tip has no OrderItem at all, a tip from a
  // release page also keeps that release as its one quantity-0 OrderItem.
  tipRecipientId  String?
  tipRecipient    User?   @relation("TipsReceived", fields: [tipRecipientId], references: [id])

  items            OrderItem[]
  payment          Payment?
  entitlements     Entitlement[]
  ledgerEntries    WalletLedgerEntry[]
  merchFulfillment MerchOrderFulfillment?
  gift             Gift?

  @@index([checkoutGroupId])
  @@index([discountId])
}

model OrderItem {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])
  productId    String
  product      Product       @relation(fields: [productId], references: [id])
  priceKobo    Int // per-unit snapshot at purchase time, independent of later price edits
  // Merch size/colour the buyer picked (MerchVariant), with a readable
  // snapshot ("M · Black") so later variant edits never change past orders.
  variantId    String?
  variant      MerchVariant? @relation(fields: [variantId], references: [id])
  variantLabel String?
  // Beat license tier the buyer agreed to (BeatLicense), with its name and
  // full terms snapshotted — the license agreement is generated from these.
  licenseId    String?
  license      BeatLicense?  @relation(fields: [licenseId], references: [id])
  licenseName  String?
  licenseTerms Json?
  // Ticket/merch group buys (EVENT/MERCH only — RELEASE/BEAT stay quantity 1,
  // enforced in the orders API, not here). One Entitlement is still created
  // per unit (see Entitlement's own comment), so each ticket keeps its own
  // check-in code; this field is what confirmStock/reserveStock act on and
  // what the total charge (priceKobo * quantity + any flat shipping) is
  // computed from.
  quantity     Int           @default(1)
}

enum PaymentStatus {
  INITIATED
  SUCCESSFUL
  FAILED
}

model Payment {
  id                       String        @id @default(cuid())
  // Exactly one of orderId/billboardId/creatorPlanUserId/coinTopUpUserId is
  // ever set — same optional-FK side-by-side pattern as WalletLedgerEntry's
  // orderId/payoutId. A Billboard's Bachs checkout (lib/commerce/
  // billboards.ts), a creator-plan charge (lib/commerce/creatorPlans.ts),
  // and an XG top-up (lib/live/coins.ts) are the only other things this
  // Payment/webhook pipeline pays for besides an Order.
  orderId                  String?       @unique
  // Cart checkout (v2, 2026-11-09): one payment for several orders. The
  // orders share this id (Order.checkoutGroupId) and each keeps its own
  // share in Order.amountKobo. Exactly one of orderId/checkoutGroupId/
  // billboardId/creatorPlanUserId/coinTopUpUserId is set.
  checkoutGroupId          String?       @unique
  order                    Order?        @relation(fields: [orderId], references: [id])
  billboardId              String?       @unique
  billboard                Billboard?    @relation(fields: [billboardId], references: [id])
  // A LIMITED join/renewal or a BUYER_PAYS_FEE slot-pack purchase —
  // creatorPlanPaymentKind tells the Bachs webhook which of the two to
  // apply on success (lib/commerce/creatorPlans.ts's
  // finalizeCreatorPlanFeePayment). Not a relation to a dedicated model
  // (unlike Billboard) since there's no separate approval-state entity —
  // success just updates the User row directly.
  creatorPlanUserId        String?
  creatorPlanPaymentKind   String? // "LIMITED_ACTIVATION" | "SLOT_PACK"
  // An XG pack purchase (lib/live/coins.ts's createCoinTopUpCheckout) —
  // same "no dedicated entity" shape as creatorPlanUserId above: success
  // just credits a CoinLedgerEntry for coinTopUpXgAmount directly.
  coinTopUpUserId          String?
  coinTopUpXgAmount        Int?
  // A catalog subscription payment (lib/subscriptions/payments.ts) — first
  // subscribe, a manual renewal, or (once a processor supports it) an
  // automatic renewal. Same "no order" shape as the XG top-up above: on
  // success the subscriber's CatalogSubscription is created or extended by
  // subscriptionDurationDays. subscriptionSubscriberId is set exactly when
  // this is a subscription payment.
  subscriptionSubscriberId String?
  subscriptionCreatorId    String?
  subscriptionDurationDays Int?
  subscriptionAutoRenew    Boolean?
  // A paid community membership (lib/communities/payments.ts): joining,
  // renewing early or an automatic renewal. Set together.
  membershipUserId         String?
  membershipGroupId        String?
  membershipPlanId         String?
  membershipAutoRenew      Boolean?
  processor                String        @default("flutterwave")
  processorRef             String        @unique // tx_ref; webhook idempotency key
  // Flutterwave's own numeric transaction id (verifyTransaction()'s `id`) —
  // distinct from processorRef/tx_ref, which is ours. The refund endpoint
  // (POST /transactions/{id}/refund) takes this one, not the tx_ref, so it
  // has to be captured at webhook time or a refund has nothing to call.
  providerTransactionId    String?
  status                   PaymentStatus @default(INITIATED)
  amountKobo               Int
  webhookReceivedAt        DateTime?
  rawPayload               Json?
  createdAt                DateTime      @default(now())
}

// The header bell — deliberately transactional/money-related only (a sale
// made, an order paid, a payout started/failed, a refund) and never Socials
// activity (follows/comments/likes/group messages/join requests), which has
// its own separate in-app signal: the unread badge on the Socials nav tab
// (lib/socials/unread.ts). Two different signals for two different kinds of
// "something happened" on purpose, not an oversight.
enum NotificationKind {
  SALE
  ORDER_PAID
  PAYOUT_INITIATED
  PAYOUT_FAILED
  PAYOUT_PAID
  REFUND
  // Moderator-only: something landed in a moderation queue (lib/moderation/attention.ts).
  MODERATION
  // Social activity — saved to the bell too (not push-only), so it persists.
  FOLLOW
  LIKE
  COMMENT
  FANBASE
  // The daily "you have unread notifications" nudge.
  REMINDER
  // The outcome of the user's own verification application.
  VERIFICATION
  // Someone you follow (or asked to be reminded about) just went live.
  LIVE
  // A featured-artist request (or its answer) — ReleaseCollaborator.
  COLLABORATION
}

// Guest checkout email check (explicit ask, 2026-10-15): a buyer with no
// account must prove they own the email before an order is created for it —
// a typo used to send the purchase (and create/attach an account) to a
// stranger's address. One row per code sent; `token` is set once the code is
// entered correctly and is what POST /api/orders accepts as proof (see
// lib/commerce/guestVerification.ts).
model GuestEmailVerification {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  token      String?   @unique
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  kind      NotificationKind
  title     String
  body      String
  url       String?
  // Two separate states (explicit ask, 2026-10-04): seenAt is set for every
  // notification as soon as the bell/Notifications screen is opened, and
  // drives the bell badge, push badge counts and the daily reminder.
  // readAt is set when this notification itself is opened (or its merged
  // group is expanded), and drives the unread styling in the list.
  seenAt    DateTime?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

// ─── Gifting (PRD §7.3 Phase 2) ─────────────────────────────────────────
// A gift purchase runs through the exact same checkout/webhook pipeline as a
// normal buy (Order.isGift just tells the webhook to create a Gift instead
// of an Entitlement) — reserveStock/confirmStock/recordSale are untouched.
// "Stock decrements at purchase, not claim" falls out of that reuse for
// free. Scoped to RELEASE/BEAT/EVENT-tier only, not MERCH — a claim link
// with no recipient identity has no shipping address to gift physical goods to.

enum GiftStatus {
  PENDING
  CLAIMED
  EXPIRED
  REFUNDED
}

model Gift {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  giverId     String
  giver       User       @relation("GiftsSent", fields: [giverId], references: [id])
  orderId     String     @unique
  order       Order      @relation(fields: [orderId], references: [id])
  claimToken  String     @unique @default(cuid())
  status      GiftStatus @default(PENDING)
  claimedById String?
  claimedBy   User?      @relation("GiftsClaimed", fields: [claimedById], references: [id])
  claimedAt   DateTime?
  expiresAt   DateTime // claim window; PRD §18 open decision — defaulted to 7 days, see DECISIONS.md
  createdAt   DateTime   @default(now())

  @@index([giverId])
  @@index([status, expiresAt])
}

// ─── Trust & safety ─────────────────────────────────────────────────────

enum ReportTargetType {
  CONVERSATION // a direct-message thread (lib/messages/), reported by one of its two people
  PRODUCT
  EVENT // Event is not a Product (DECISIONS.md — tiers are); reported separately
  POST
  COMMENT
  PROFILE
  COMMUNITY // v2 communities (Report.groupId)
}

enum ReportReason {
  INAPPROPRIATE_CONTENT
  COPYRIGHT_CLAIM
  BUG
  FEATURE_REQUEST
  // Community reports (v2, design/v2-prototype).
  SPAM_OR_SCAM
  FRAUDULENT_PAYMENTS
  ABUSE_OR_HARASSMENT
  ILLEGAL_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

// PRODUCT/EVENT/POST/PROFILE each have their own optional FK, exactly one set
// per row depending on targetType — COMMENT has no FK yet since Comment
// doesn't exist until Phase 2 groups ship (the enum member stays for forward compat).
model Report {
  id             String           @id @default(cuid())
  reporterId     String
  reporter       User             @relation("ReportsFiled", fields: [reporterId], references: [id])
  targetType     ReportTargetType
  productId      String?
  product        Product?         @relation("ReportsOnProduct", fields: [productId], references: [id])
  eventId        String?
  event          Event?           @relation("ReportsOnEvent", fields: [eventId], references: [id])
  postId         String?
  post           Post?            @relation("ReportsOnPost", fields: [postId], references: [id])
  profileId      String?
  profile        User?            @relation("ReportsOnProfile", fields: [profileId], references: [id])
  conversationId String?
  conversation   Conversation?    @relation(fields: [conversationId], references: [id])
  groupId        String?
  group          FanbaseGroup?    @relation("ReportsOnCommunity", fields: [groupId], references: [id])
  reason         ReportReason
  details        String? // reporter's free-text context, optional
  status         ReportStatus     @default(OPEN)
  slaDueAt       DateTime? // set for time-critical reasons (inappropriate content, copyright) — PRD §14
  createdAt      DateTime         @default(now())

  @@index([status])
}

// ─── Moderator step-up OTP ────────────────────────────────────────────────
// A moderator signs into /moderation with the exact same email/password as
// their regular XOLDOUT account (no separate moderator signup) — this is
// the extra one-time-code step that route specifically requires on top of
// that, emailed fresh on every request. Only the hash is ever stored, same
// reasoning as never storing a password in plaintext. The 60s
// inactivity-timeout itself is enforced client-side (lib/useModeratorSession.ts)
// against a sessionStorage timestamp, not this table — this table only
// answers "was a valid code entered," not "is the session still fresh."
model ModeratorOtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

// ─── Verification ────────────────────────────────────────────────────────
// A user (or, for FANBASE, a group they own) applies for one of these types;
// on approval a specific VerificationBadgeType is granted. The split exists
// because FANBASE applications can be approved as either OFFICIAL_FANBASE
// (proven authorization) or the lesser RECOGNIZED_COMMUNITY — the applicant
// requests FANBASE, the reviewer decides which badge that actually earns.
// Every other type maps 1:1 to its badge (SELLER -> SELLER_VERIFIED, etc).

enum VerificationType {
  IDENTITY
  SELLER
  CREATOR
  OFFICIAL
  BUSINESS
  FANBASE
}

enum VerificationBadgeType {
  IDENTITY_VERIFIED
  SELLER_VERIFIED
  CREATOR_VERIFIED
  OFFICIAL_ACCOUNT
  TRUSTED_BUSINESS
  OFFICIAL_FANBASE
  RECOGNIZED_COMMUNITY
}

enum VerificationApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
  REVOKED
  EXPIRED
}

enum VerificationDocumentType {
  ID_FRONT
  ID_BACK
  SELFIE
  PROOF_OF_ADDRESS
  BUSINESS_REGISTRATION
  SUPPORTING_EVIDENCE
}

enum VerificationDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum VerificationAuditAction {
  APPLICATION_CREATED
  DOCUMENT_UPLOADED
  APPLICATION_SUBMITTED
  MOVED_UNDER_REVIEW
  INFO_REQUESTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  VERIFICATION_SUSPENDED
  VERIFICATION_REVOKED
  VERIFICATION_EXPIRED
}

// One draft/application per attempt — a user can have multiple historical
// rows per type (e.g. rejected, then reapplied) but at most one in a
// non-terminal status (DRAFT/SUBMITTED/UNDER_REVIEW/MORE_INFO_REQUIRED) per
// type at a time, enforced in the API layer rather than a DB constraint
// (Postgres partial unique indexes aren't expressible in Prisma's schema
// language without raw SQL — see lib/verification/applications.ts).
model VerificationApplication {
  id     String                        @id @default(cuid())
  userId String
  user   User                          @relation("VerificationApplicant", fields: [userId], references: [id])
  type   VerificationType
  status VerificationApplicationStatus @default(DRAFT)

  // Only set for type FANBASE — the group being verified, as opposed to the
  // applicant themselves (who's the group's creator/owner, checked at the
  // API layer). Null for every other type.
  groupId String?
  group   FanbaseGroup? @relation(fields: [groupId], references: [id])

  // Step 2 — personal information
  legalFirstName String?
  legalLastName  String?
  dateOfBirth    DateTime?
  country        String?
  region         String?
  phone          String?
  photoUrl       String? // private storage key, not a public avatar

  // Step 3 — identity document metadata (the actual images are
  // VerificationDocument rows; this is just what the document *is*).
  documentType      String? // "NIN" | "PASSPORT" | "DRIVERS_LICENSE" | "VOTERS_CARD"
  documentNumber    String? // never returned in a public/list API response — see lib/verification/serialize.ts
  documentExpiresAt DateTime?

  // Step 5 — everything specific to the chosen type (creator's social
  // links, business registration info, fanbase evidence, etc.) — one JSON
  // blob rather than a dozen mostly-null columns, since each type's extra
  // fields are completely different and none need to be queried/filtered
  // on individually.
  categoryData Json?

  // What checkVerificationEligibility() returned at submit time — an audit
  // trail proving the applicant really was eligible when they applied, even
  // if their standing changes later while the application is under review.
  eligibilitySnapshot Json?

  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewer              User?                  @relation("VerificationReviewer", fields: [reviewedBy], references: [id])
  approvedAt            DateTime?
  rejectedAt            DateTime?
  rejectionReason       String? // user-facing
  additionalInfoRequest String? // user-facing, set when status = MORE_INFO_REQUIRED
  internalNotes         String? // moderator-only, never exposed to the applicant
  grantedBadgeType      VerificationBadgeType? // set on approval; see comment above the enum block
  expiresAt             DateTime?
  revokedAt             DateTime?
  revokedReason         String?
  suspendedAt           DateTime?
  suspendedReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents VerificationDocument[]
  auditLogs VerificationAuditLog[]

  @@index([userId, status])
  @@index([status, type])
  @@index([groupId])
}

// storageKey is a private R2 object key, resolved to a short-TTL signed URL
// on demand (lib/storage/r2.ts's presignDownload) — never a public URL,
// never returned directly by any list/detail API response.
model VerificationDocument {
  id            String                     @id @default(cuid())
  applicationId String
  application   VerificationApplication    @relation(fields: [applicationId], references: [id])
  documentType  VerificationDocumentType
  storageKey    String
  status        VerificationDocumentStatus @default(PENDING)
  uploadedAt    DateTime                   @default(now())
  reviewedAt    DateTime?

  @@index([applicationId])
}

model VerificationAuditLog {
  id            String                  @id @default(cuid())
  applicationId String
  application   VerificationApplication @relation(fields: [applicationId], references: [id])
  actorId       String
  actor         User                    @relation("VerificationAuditActor", fields: [actorId], references: [id])
  action        VerificationAuditAction
  metadata      Json?
  createdAt     DateTime                @default(now())

  @@index([applicationId, createdAt])
}

// ─── Ambassador program ─────────────────────────────────────────────────
// Platform-wide referral role — deliberately not tied to any one creator
// (contrast with EventPromoter below, which is exactly that). An approved
// ambassador refers new *users*; every sale a referred user later makes,
// to any creator, automatically credits the ambassador a tier-based % of
// the platform's own commission on that sale (never the seller's net —
// the seller has no relationship with the ambassador program). Tier itself
// is never stored — it's derived at read/write time from cumulative
// referred-revenue via lib/commerce/constants.ts's ambassadorTierFor().

enum AmbassadorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AmbassadorApplication {
  id              String                      @id @default(cuid())
  userId          String
  user            User                        @relation("AmbassadorApplicant", fields: [userId], references: [id])
  pitch           String?
  status          AmbassadorApplicationStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewer        User?                       @relation("AmbassadorReviewer", fields: [reviewedBy], references: [id])
  rejectionReason String?
  createdAt       DateTime                    @default(now())

  @@index([userId, status])
  @@index([status])
}

// Two tiers only (explicit ask, 2026-09-14 — down from the original
// Bronze/Silver/Gold/Platinum ladder): every approved ambassador starts at
// SILVER; GOLD is reached by active-invite count, not revenue
// (lib/commerce/constants.ts's ambassadorTierFor/AMBASSADOR_GOLD_ACTIVE_INVITES).
enum AmbassadorTier {
  SILVER
  GOLD
}

// Moderator-configurable, per tier: firstPurchasePercent is what the
// ambassador earns (of the platform's own commission) the first time a
// person they referred ever buys anything; continuousPercent is the lower
// ongoing rate for every purchase after that same person's first. Rows are
// lazily upserted with starting defaults the first time they're read, not
// seeded via migration data. See lib/commerce/ledger.ts's
// recordAmbassadorCommission.
model AmbassadorTierRate {
  tier                 AmbassadorTier @id
  firstPurchasePercent Int
  continuousPercent    Int
  updatedAt            DateTime       @updatedAt
  updatedBy            String?
}

// ─── Platform settings ───────────────────────────────────────────────────
// Singleton row (fixed id, lazily upserted on first read — same pattern as
// AmbassadorTierRate above) for platform-wide toggles a super-moderator
// controls. Currently just the real-file-download feature for songs/beats
// (PurchaseAndPlayer/BeatPurchaseAndPlayer's Download button and the
// /api/tracks|beats/[id]/audio-url?download=1 routes both check this).
model PlatformSettings {
  id                            String    @id @default("singleton")
  downloadsEnabled              Boolean   @default(true)
  // ₦5,000/day starting default — see lib/commerce/billboards.ts's
  // getBillboardDailyRateKobo(). What a creator pays for one day of the
  // Discover billboard rail; moderator-editable via SiteControlsPanel.
  billboardDailyRateKobo        Int       @default(500000)
  // Per-product-type commission for CreatorPlan.UNLIMITED sellers only
  // (DECISIONS.md) — super-moderator-editable via SiteControlsPanel
  // (lib/commerce/ledger.ts's getCommissionRates() reads these;
  // lib/commerce/constants.ts's COMMISSION_RATE/EVENT_COMMISSION_RATE are
  // now just the starting defaults below, not the live rate). Whole
  // percent, matching AmbassadorTierRate's own convention. BUYER_PAYS_FEE
  // has its own separate flat rate (buyerPaysFeePercent below) and LIMITED
  // has none at all — this table no longer applies platform-wide.
  // Explicit ask, 2026-09-22: "no upfront plan fee, 12% Xoldout fee, you
  // keep 88%" for Unlimited — Release/Beat/Merch moved to 12% (matches
  // what production's own pre-existing singleton row already held — the
  // earlier bump to 15 here only ever affected a brand-new row's default,
  // never actually applied in production). Event stays separate at its
  // original 5% (creator still bears the real-world cost of the show) —
  // confirmed with the user: tickets are NOT folded into the flat 12%.
  commissionReleasePercent      Int       @default(12)
  commissionBeatPercent         Int       @default(12)
  commissionMerchPercent        Int       @default(12)
  commissionEventPercent        Int       @default(5)
  // Platform cut of fan tips (explicit ask, 2026-11-06: "same commission as
  // sales but editable in admin"). Applies to UNLIMITED and BUYER_PAYS_FEE
  // sellers; LIMITED sellers keep 100% of tips, as they do of sales.
  commissionTipPercent          Int       @default(12)
  // Platform cut of catalog subscription payments (explicit ask, 2026-11-09:
  // "separate, editable in admin"). LIMITED sellers keep 100%, as with tips.
  commissionSubscriptionPercent Int       @default(12)
  // Platform cut of paid community memberships (prototype: "Platform
  // commission on paid memberships"), super-moderator editable.
  commissionMembershipPercent   Int       @default(12)
  // ─── Creator plans: BUYER_PAYS_FEE ─────────────────────────────────────
  // Service-charge rate added on top of the price at checkout and paid by
  // the buyer — lib/commerce/creatorPlans.ts, app/api/orders/route.ts.
  // Explicit ask, 2026-09-22: Events get their own separate rate
  // (buyerPaysFeeEventPercent) — same reasoning as the UNLIMITED table
  // singling out tickets, ticket economics differ from a digital-goods
  // sale. Release/Beat/Merch still share the one flat buyerPaysFeePercent.
  // Upload cap is live-product-count-based (User has no counter for it, see
  // User's own comment) — buyerPaysFeeSlotPackFeeKobo buys
  // buyerPaysFeeSlotPackSize more room, stacking indefinitely, whenever a
  // creator hits the cap.
  buyerPaysFeePercent           Int       @default(12)
  buyerPaysFeeEventPercent      Int       @default(12)
  buyerPaysFeeUploadCap         Int       @default(50)
  buyerPaysFeeSlotPackSize      Int       @default(50)
  buyerPaysFeeSlotPackFeeKobo   Int       @default(400000)
  // ─── Creator plans: LIMITED ─────────────────────────────────────────────
  // Flat one-time fee (wallet-or-Bachs, lib/commerce/creatorPlans.ts) to
  // join OR renew — both charge the same amount and both reset
  // User.limitedUploadsUsed to 0 for a fresh cycle. Explicit ask,
  // 2026-09-22: sales are unlimited on this plan — there is no sales cap,
  // renewal is only ever triggered by hitting limitedPlanUploadCap.
  limitedPlanFeeKobo            Int       @default(400000)
  limitedPlanUploadCap          Int       @default(100)
  // ─── Xoldout Live: XG -> Naira creator payout rate ─────────────────────
  // Explicit ask, 2026-10-04: "₦6 per XG, super moderator can edit".
  // Snapshotted onto each XgEarning row the moment the XG is received, so
  // editing this never changes the value of XG a creator already earned.
  xgPayoutRateKobo              Int       @default(600)
  // Explicit ask, 2026-10-04: "make the payout for live coins 1 week for now
  // and can be changed later by super admins". Days each received XG is held
  // before it is paid into the wallet (lib/live/xgEarnings.ts). Read live,
  // so a change applies to XG still being held.
  xgPayoutHoldDays              Int       @default(7)
  // The most recently published Android APK — written by mobile's
  // `npm run publish-apk` script (POST /api/internal/apk-release, secret-
  // gated) after it builds via EAS and uploads the artifact to R2. Read by
  // GET /api/mobile/version, which both the web Android-install banner and
  // the mobile app's own in-app update check poll. buildNumber is our own
  // monotonic counter (mobile/app.json's extra.buildNumber) — not Android's
  // versionCode, which EAS's `preview` profile doesn't auto-increment.
  latestApkVersion              String?
  latestApkBuildNumber          Int?
  latestApkUrl                  String?
  latestApkReleasedAt           DateTime?
  updatedAt                     DateTime  @updatedAt
  updatedBy                     String?
}

// ─── Billboards ─────────────────────────────────────────────────────────
// A rotating promotional artwork rail on the Discover page (see
// components/discover/BillboardRail.tsx). Creators pay
// PlatformSettings.billboardDailyRateKobo for one day live, debited from
// their wallet if it covers the cost, otherwise via a real Bachs checkout
// for the full amount (lib/commerce/billboards.ts) — only one active/pending
// billboard per creator at a time. Moderators can also add one manually
// (isModeratorAdded, no payment) and override any billboard's expiresAt
// past the 1-day default.
enum BillboardStatus {
  PENDING_PAYMENT // Bachs checkout started, not yet confirmed
  PENDING_REVIEW // paid (wallet or Bachs), awaiting moderator approval
  ACTIVE
  REJECTED // moderator declined — always refunded, always has a reason
  REMOVED // moderator-deactivated an ACTIVE one, or an abandoned PENDING_PAYMENT swept
}

model Billboard {
  id               String              @id @default(cuid())
  creatorId        String?
  creator          User?               @relation(fields: [creatorId], references: [id])
  artworkUrl       String
  status           BillboardStatus     @default(PENDING_PAYMENT)
  isModeratorAdded Boolean             @default(false)
  // Creator-chosen at purchase time (explicit ask: "they should also be
  // allowed to choose how many days ... that will determine how much they
  // are paying") — paidKobo = days * PlatformSettings.billboardDailyRateKobo
  // at the rate in effect when they bought it. Stored (not just derived from
  // expiresAt-activatedAt) so a Bachs purchase still knows how many days to
  // grant once the webhook actually confirms payment, and so a moderator's
  // "extend" action has a real unit to add to.
  days             Int                 @default(1)
  paidKobo         Int                 @default(0)
  activatedAt      DateTime?
  expiresAt        DateTime?
  rejectionReason  String?
  createdAt        DateTime            @default(now())
  updatedBy        String?
  payment          Payment?
  ledgerEntries    WalletLedgerEntry[]
  // What tapping the billboard opens (explicit ask: creators attach their
  // song/beat/merch/event). At most one of productId/eventId is set — same
  // optional-FK side-by-side pattern as Payment's targets. Both null = the
  // creator's profile, the original behavior. EVENT-type products are never
  // stored here; an event links via eventId to its own /e/[id] page.
  productId        String?
  product          Product?            @relation(fields: [productId], references: [id])
  eventId          String?
  event            Event?              @relation(fields: [eventId], references: [id])
  // Every on-screen impression, not unique viewers (explicit ask: "anytime a
  // user sees it should count, not just a one time view") — incremented in
  // batches by POST /api/billboards/views from components/discover/BillboardRail.
  viewCount        Int                 @default(0)

  @@index([status, expiresAt])
  @@index([creatorId])
}

// Which moderation-dashboard panels a *regular* moderator sees — a
// super-moderator always sees every panel regardless of this table (same
// "super-mods see everything" precedent as ManageModeratorsPanel, which
// isn't configurable at all for that reason). Missing rows default to
// visible; a super-moderator only ever writes a row to hide something.
// panelKey values match the PANEL_KEYS list in app/(app)/moderation/page.tsx.
model ModerationPanelVisibility {
  panelKey  String   @id
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ─── Ticket promoter split ──────────────────────────────────────────────
// Per-event, independent of the Ambassador program above: an event creator
// adds any user as a promoter for *their* event and sets a % of *their own*
// net proceeds to share on tickets sold through that promoter's link
// (`?promo=<code>`, resolved at checkout in app/api/orders/route.ts).

model EventPromoter {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  sharePercent Int
  code         String   @unique @default(cuid())
  createdAt    DateTime @default(now())
  // Applications (2026-11-11): "PENDING" | "APPROVED" | "REJECTED". Host-added promoters are APPROVED.
  status       String    @default("APPROVED")
  decidedAt    DateTime?
  clickCount   Int       @default(0)

  orders Order[]

  @@unique([eventId, userId])
  @@index([eventId])
}

// ─── Xoldout Live ────────────────────────────────────────────────────────
// A session's video is never stored (explicit product decision: "Lives
// aren't saved" — the LiveKit room is ephemeral, torn down on end, see
// lib/live/liveKit.ts). Only money-relevant facts persist here, same
// ledger-not-a-cache philosophy as WalletLedgerEntry: the session's own
// metadata/stats, and every gift/paid-access/paid-request row.

enum LiveSessionStatus {
  // Created ahead of time with a shareable link (explicit ask) — no LiveKit
  // room yet; the host starts it, which creates the room and flips it LIVE.
  SCHEDULED
  LIVE
  ENDED
}

model LiveSession {
  id               String            @id @default(cuid())
  creatorId        String
  creator          User              @relation(fields: [creatorId], references: [id])
  title            String
  description      String?
  coverImageLadder Json?
  roomName         String?           @unique // LiveKit room name (lib/live/liveKit.ts); null until a SCHEDULED Live starts
  status           LiveSessionStatus @default(LIVE)
  // Only meaningful together: isPaidAccess false ignores priceXg entirely
  // (matches TicketTier's own priceKobo=0-is-free convention).
  isPaidAccess     Boolean           @default(false)
  priceXg          Int               @default(0)
  pinnedProductId  String?
  pinnedProduct    Product?          @relation(fields: [pinnedProductId], references: [id])
  peakViewers      Int               @default(0)
  // Set up as a battle from the Go Live form (explicit ask, 2026-10-08):
  // badged as a battle on cards/links, and the host's battle setup opens as
  // soon as the Live starts. The battles themselves are LiveBattle rows.
  isBattle         Boolean           @default(false)
  // When a SCHEDULED Live is planned to start (shown as a countdown on its
  // link). startedAt is reset to the real start time when it goes live.
  scheduledFor     DateTime?
  startedAt        DateTime          @default(now())
  endedAt          DateTime?

  gifts         LiveGift[]
  accessGrants  LiveAccessGrant[]
  requests      LiveRequest[]
  reminders     LiveReminder[]
  moderators    LiveModerator[]
  stageRequests LiveStageRequest[]
  guestAlerts   LiveGuestAlert[]
  battles       LiveBattle[]

  @@index([creatorId])
  @@index([status])
}

// "Remind me" on a scheduled Live — everyone here is notified when it starts.
model LiveReminder {
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())

  @@id([liveSessionId, userId])
  @@index([userId])
}

// Fixed catalog for v1 — mirrors TicketTier's own "simple enum, not a config
// table" choice. Price-per-type and display metadata live in
// lib/live/gifts.ts, not the DB (same as e.g. MINIMUM_WITHDRAWAL_KOBO
// elsewhere), so adding a gift is a code change, not a migration, until
// there's a real reason for creators/moderators to configure the catalog.
enum LiveGiftType {
  STAR
  MIC
  MONEY_SPRAY
  GRAMMY
}

model LiveGift {
  id            String       @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession  @relation(fields: [liveSessionId], references: [id])
  senderId      String
  sender        User         @relation(fields: [senderId], references: [id])
  type          LiveGiftType
  xgAmount      Int // snapshot at send time, independent of a later catalog price change
  // Battles (lib/live/battle.ts): a gift sent to a competitor instead of
  // the host. Null = to the host, as before.
  recipientId   String?
  recipient     User?        @relation("LiveGiftsReceived", fields: [recipientId], references: [id])
  battleId      String?
  battle        LiveBattle?  @relation(fields: [battleId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([liveSessionId, createdAt])
  @@index([senderId])
}

// One per (session, viewer) — a paid-access Live is bought once, not
// per-view, same "entitlement not a per-request check" shape as a ticket.
model LiveAccessGrant {
  id            String      @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  xgPaid        Int
  createdAt     DateTime    @default(now())

  @@unique([liveSessionId, userId])
}

// ─── Live co-hosting (explicit ask, 2026-10-04) ──────────────────────────
// "The host should be able to add another person to the live from the list
// of people who joined, appoint live moderators, and those who joined can
// request to join the live and get approved by the host or a moderator."
//
// Who is actually on stage lives in LiveKit itself (the participant's
// canPublish permission, flipped server-side by lib/live/stage.ts) — never in
// Postgres, so it can't drift from what the room is really doing. These two
// tables hold only what LiveKit doesn't: who the host appointed as a
// moderator for this Live, and the queue of requests to come on stage.
model LiveModerator {
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())

  @@id([liveSessionId, userId])
}

enum LiveStageRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

// One row per (Live, viewer): re-requesting after a decline/cancel reuses it.
model LiveStageRequest {
  id            String                 @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession            @relation(fields: [liveSessionId], references: [id])
  userId        String
  user          User                   @relation(fields: [userId], references: [id])
  status        LiveStageRequestStatus @default(PENDING)
  respondedById String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([liveSessionId, userId])
  @@index([liveSessionId, status])
}

// One row per (Live, guest) whose followers were told "X is live with Host"
// (explicit ask, 2026-10-08: anyone who comes on stage, battle competitors
// included, calls their followers in). Inserted before the alert goes out,
// so stepping down and back up — or a battle bringing an already-alerted
// competitor on stage — never pings the same followers twice.
model LiveGuestAlert {
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())

  @@id([liveSessionId, userId])
}

enum LiveRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model LiveRequest {
  id            String            @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession       @relation(fields: [liveSessionId], references: [id])
  senderId      String
  sender        User              @relation(fields: [senderId], references: [id])
  message       String
  xgAmount      Int
  status        LiveRequestStatus @default(PENDING)
  createdAt     DateTime          @default(now())

  @@index([liveSessionId, status])
}

// ─── XG: Xoldout Gifts, a buyer-funded prepaid balance ──────────────────
// Same ledger-not-a-balance-column philosophy as WalletLedgerEntry, but a
// deliberately separate table/currency: XG is bought with real money
// (lib/live/coins.ts, same Bachs-checkout shape as a Billboard/creator-plan
// charge) and spent on gifts/paid access/paid requests, but is never cashed
// back out to the buyer — one-directional by design, so this never becomes
// an unlicensed money-transmission product. Only the *creator's* resulting
// earnings (LedgerKind LIVE_GIFT_CREDIT et al, on the existing
// WalletLedgerEntry/payout pipeline) are ever withdrawable.
// Balance = SUM(xgAmount) WHERE userId = ?.
enum CoinLedgerKind {
  TOPUP_CREDIT
  GIFT_DEBIT
  PAID_ACCESS_DEBIT
  PAID_REQUEST_DEBIT
  // A battle's prize, held from the host's XG when the battle starts
  // (lib/live/battle.ts) and returned for any place nobody won, or a cancel.
  BATTLE_PRIZE_HOLD
  BATTLE_PRIZE_REFUND
}

model CoinLedgerEntry {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  xgAmount  Int // signed: credits positive, debits negative
  kind      CoinLedgerKind
  createdAt DateTime       @default(now())

  @@index([userId])
}

// A creator's *earned* XG balance — what they've received from gifts, paid
// access and paid requests, kept apart from CoinLedgerEntry (XG a viewer
// bought), so earned XG can never be re-spent and bought XG can never be
// withdrawn. Explicit ask, 2026-10-04: "everything received should go to
// XG balance and withdrawable at the end of the month like Meta does".
// koboPerXg is PlatformSettings.xgPayoutRateKobo at the moment of receipt;
// convertedAt/walletLedgerEntryId are set together by the daily
// conversion (lib/live/xgEarnings.ts), which pays out every row whose
// PlatformSettings.xgPayoutHoldDays hold has ended as one
// XG_EARNINGS_PAYOUT credit.
enum XgEarningSource {
  LIVE_GIFT
  LIVE_ACCESS
  LIVE_REQUEST
  BATTLE_PRIZE // a battle winner's share of the host's prize
}

model XgEarning {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id])
  xgAmount            Int
  koboPerXg           Int
  source              XgEarningSource
  liveSessionId       String?
  createdAt           DateTime        @default(now())
  convertedAt         DateTime?
  walletLedgerEntryId String?

  @@index([userId, convertedAt])
  @@index([convertedAt, createdAt])
}

// ─── Site visits (moderator dashboard) ──────────────────────────────────
// One row per (visitor, UTC day): unique visitors = row count, page views =
// SUM(pageViews). visitorHash is an HMAC of IP + user agent under a server
// secret (lib/analytics/visits.ts) — no raw IP is ever stored, but the same
// browser hashes the same across days, so weekly/monthly/all-time uniques
// are COUNT(DISTINCT visitorHash). country is the geo-IP ISO code at first
// visit that day ("ZZ" when unknown, e.g. local dev).
model SiteVisitorDay {
  id          String   @id @default(cuid())
  day         DateTime @db.Date
  visitorHash String
  country     String
  pageViews   Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([day, visitorHash])
  @@index([day, country])
}

// ─── Background work queue ──────────────────────────────────────────────
// Polled by the worker service. No Redis needed at this scale.

enum JobType {
  TRANSCODE
  WAVEFORM
  STOCK_SWEEP
  SETTLEMENT_SWEEP
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Job {
  id        String    @id @default(cuid())
  type      JobType
  payload   Json
  status    JobStatus @default(QUEUED)
  attempts  Int       @default(0)
  lastError String?
  runAt     DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@index([status, runAt])
}

// ─── Direct messages (explicit ask, 2026-10-04) ────────────────────────────
// One-to-one conversations between users — see lib/messages/. Requests work
// like Instagram's: a first message from someone the recipient doesn't
// follow lands in their Requests (participant status REQUEST) and the
// sender can't send more until it's accepted. Disappearing messages work
// like WhatsApp's, except that turning them on, changing the timer or
// turning them off is a proposal the other person must approve.
//
// pairKey is the two user ids sorted and joined, so a pair can only ever
// have one conversation, however many times either side starts one.
model Conversation {
  id            String   @id @default(cuid())
  pairKey       String   @unique
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  // Active disappearing-messages timer in seconds, null when off. New
  // messages get expiresAt = createdAt + this.
  disappearSeconds        Int?
  // A proposed change waiting for the other person: seconds, or 0 for "off".
  pendingDisappearSeconds Int?
  pendingDisappearById    String?

  participants ConversationParticipant[]
  messages     DirectMessage[]
  reports      Report[]

  @@index([lastMessageAt])
}

enum ConversationParticipantStatus {
  ACTIVE // in their inbox
  REQUEST // a message request they haven't accepted
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                          @relation(fields: [userId], references: [id])
  status         ConversationParticipantStatus @default(ACTIVE)
  // Read receipts and unread counts: messages after this are unread.
  lastReadAt     DateTime?
  // Set when they delete the conversation (or a request) from their list;
  // a newer message brings it back.
  hiddenAt       DateTime?
  // Muted (no pushes or in-app banners from this chat) until this time.
  // Unread counts still show in the inbox.
  mutedUntil     DateTime?
  createdAt      DateTime                      @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

enum DirectMessageKind {
  TEXT
  IMAGE
  SHARE // a product or Live card (shareType + shareId)
  SYSTEM // "Disappearing messages set to 24 hours" and similar
}

model DirectMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation(fields: [senderId], references: [id])
  kind           DirectMessageKind @default(TEXT)
  body           String?
  imageUrl       String?
  shareType      String? // "PRODUCT" | "LIVE"
  shareId        String?
  createdAt      DateTime          @default(now())
  // "Delete for everyone": content is cleared and the bubble reads
  // "Message deleted".
  deletedAt      DateTime?
  // Disappearing messages: hidden once past, purged daily.
  expiresAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([expiresAt])
}

// Blocking (direct messages, for now): neither side can message the other,
// and the conversation disappears from the blocker's list.
model UserBlock {
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ─── Live battles (explicit ask, 2026-10-08) ─────────────────────────────
// "Competitions and things like rap battles in Live: a host, a timer for
// each competitor's turn, recorded; each competitor has supporters who gift
// them; the host sets a reward for the winner(s)." Run inside a host's Live
// (lib/live/battle.ts). Only results are recorded — never video.
//
// Score = 50% share of the battle's gift XG + 50% share of the audience
// vote. The host's prize XG is held from their balance at start and paid to
// the top `prizePlaces.length` competitors as earned XG.
enum LiveBattleStatus {
  READY // created, not started yet
  IN_PROGRESS
  VOTING
  FINISHED
  CANCELLED
}

model LiveBattle {
  id            String           @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession      @relation(fields: [liveSessionId], references: [id])
  hostId        String
  host          User             @relation(fields: [hostId], references: [id])
  title         String
  status        LiveBattleStatus @default(READY)
  rounds        Int
  turnSeconds   Int
  votingSeconds Int
  // XG per place, best first — e.g. [500] for one winner, [300, 150, 50] for three.
  prizePlaces   Int[]
  prizeXg       Int
  // Whose turn is on now (null between turns) and when it ends.
  currentTurnId String?
  votingEndsAt  DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime         @default(now())

  competitors LiveBattleCompetitor[]
  turns       LiveBattleTurn[]
  votes       LiveBattleVote[]
  turnVotes   LiveBattleTurnVote[]
  gifts       LiveGift[]
  invites     LiveBattleInvite[]

  @@index([liveSessionId])
  @@index([status, finishedAt])
}

model LiveBattleCompetitor {
  id        String     @id @default(cuid())
  battleId  String
  battle    LiveBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  // Turn order within each round.
  position  Int
  // Filled in when the battle finishes.
  giftsXg   Int        @default(0)
  votes     Int        @default(0)
  // Votes from viewers during this competitor's own performances.
  turnVotes Int        @default(0)
  score     Float      @default(0)
  place     Int?
  prizeXg   Int        @default(0)

  turns             LiveBattleTurn[]
  votesReceived     LiveBattleVote[]
  turnVotesReceived LiveBattleTurnVote[]

  @@unique([battleId, userId])
}

// Every turn, recorded with its real start and end.
model LiveBattleTurn {
  id           String               @id @default(cuid())
  battleId     String
  battle       LiveBattle           @relation(fields: [battleId], references: [id], onDelete: Cascade)
  competitorId String
  competitor   LiveBattleCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  round        Int
  startedAt    DateTime             @default(now())
  endsAt       DateTime
  endedAt      DateTime?
  votes        LiveBattleTurnVote[]

  @@index([battleId, round])
}

// A host inviting mutual followers into a battle (explicit ask, 2026-10-08):
// the invitee's phone rings with the battle's details; accepting makes them
// a competitor (lib/live/battle.ts respondToInvite). Pending invites lapse
// after a few minutes, or when the battle starts or is cancelled.
enum LiveBattleInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model LiveBattleInvite {
  id          String                 @id @default(cuid())
  battleId    String
  battle      LiveBattle             @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId      String
  user        User                   @relation(fields: [userId], references: [id])
  status      LiveBattleInviteStatus @default(PENDING)
  createdAt   DateTime               @default(now())
  respondedAt DateTime?
  // Last time it rang (pushed). The host's screen asks for a re-ring every
  // ~20s while it's pending, like a call that keeps ringing (explicit ask,
  // 2026-10-09); this throttles that server-side.
  lastRungAt  DateTime?

  @@unique([battleId, userId])
  @@index([userId, status, createdAt])
}

// A viewer backing whoever is performing, during their turn (explicit ask,
// 2026-10-09: a vote button while someone performs, counted toward the
// winner). One per viewer per turn; scored alongside gifts and the final
// vote (lib/live/battle.ts finishBattle).
model LiveBattleTurnVote {
  turnId       String
  turn         LiveBattleTurn       @relation(fields: [turnId], references: [id], onDelete: Cascade)
  battleId     String
  battle       LiveBattle           @relation(fields: [battleId], references: [id], onDelete: Cascade)
  competitorId String
  competitor   LiveBattleCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  voterId      String
  voter        User                 @relation(fields: [voterId], references: [id])
  createdAt    DateTime             @default(now())

  @@id([turnId, voterId])
  @@index([battleId])
}

model LiveBattleVote {
  battleId     String
  battle       LiveBattle           @relation(fields: [battleId], references: [id], onDelete: Cascade)
  voterId      String
  voter        User                 @relation(fields: [voterId], references: [id])
  competitorId String
  competitor   LiveBattleCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())

  @@id([battleId, voterId])
}

// ─── Catalog subscriptions (v2, design/v2-prototype, 2026-11-09) ──────────
// An artist offers one or more durations (Monthly / 3 months / 6 months /
// Yearly) at their own prices; a fan pays for a period and can then stream
// every song of that artist in full (no downloads — explicit ask) until
// currentPeriodEnd. Status is derived from the date, so nothing has to run
// for a subscription to expire.
model SubscriptionPlan {
  id           String   @id @default(cuid())
  creatorId    String
  creator      User     @relation("SubscriptionPlans", fields: [creatorId], references: [id])
  durationDays Int // 30, 90, 180 or 365 (lib/subscriptions/plans.ts)
  priceKobo    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([creatorId, durationDays])
}

model CatalogSubscription {
  id                  String    @id @default(cuid())
  subscriberId        String
  subscriber          User      @relation("Subscriber", fields: [subscriberId], references: [id])
  creatorId           String
  creator             User      @relation("SubscribedCreator", fields: [creatorId], references: [id])
  // The plan the next renewal uses (snapshotted from the last payment).
  durationDays        Int
  priceKobo           Int
  startedAt           DateTime  @default(now())
  currentPeriodEnd    DateTime
  // The fan's auto-renew switch. On: we renew for them — charging a saved
  // card where the processor supports it (cardToken), otherwise reminding
  // them before the end with a one-tap renew. Off: it just ends.
  autoRenew           Boolean   @default(true)
  // When the "renews soon" reminder for the current period went out.
  renewalNotifiedAt   DateTime?
  // Saved card for automatic charging — only a processor that can re-charge
  // Naira cards fills these (Flutterwave, once approved). Null with Bachs.
  cardToken           String?
  cardProcessor       String?
  cardEmail           String?
  lastChargeAttemptAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([subscriberId, creatorId])
  @@index([creatorId, currentPeriodEnd])
  @@index([autoRenew, currentPeriodEnd])
}

// Deleted content archive (explicit ask, 2026-11-11: "everything deleting is
// allowed on should be taken down and only visible to the admin as deleted
// content"). Content that used to be erased (posts, comments, song comments,
// communities, playlists, add-ons) is copied here in the same transaction,
// then deleted exactly as before — so no feed, page or mobile API can ever
// show it, and nothing extra runs on normal reads. Super moderators can view
// and restore (lib/moderation/deletedContent.ts). DMs are deliberately NOT
// archived (their text is still wiped on delete). No FKs: the record must
// outlive whatever it points at.
model DeletedContent {
  id            String    @id @default(cuid())
  kind          String // POST | COMMENT | SONG_COMMENT | COMMUNITY | PLAYLIST | ADD_ON
  targetId      String
  ownerId       String?
  deletedById   String?
  deletedByRole String // OWNER | COMMUNITY_ADMIN | CREATOR | MODERATOR
  title         String
  preview       String?
  snapshot      Json
  deletedAt     DateTime  @default(now())
  restoredAt    DateTime?
  restoredById  String?

  @@index([deletedAt])
  @@index([kind, deletedAt])
  @@index([targetId])
}
