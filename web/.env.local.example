# Copy to .env.local and fill in. Never commit real values.

# --- Database (also read by prisma.config.ts from .env) ---
# The connection_limit/timeout params match what `npx prisma dev` itself
# recommends for its embedded Postgres — omitting them let concurrent
# requests kill the local dev server outright during testing.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/xoldout?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# --- Firebase client (public — safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin (server-only secret) ---
# Full service-account JSON, either raw (starts with "{") or base64-encoded.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Cloudflare R2 (S3-compatible object storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Flutterwave ---
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# --- Monnify (second checkout processor — buyer picks at checkout) ---
# MONNIFY_BASE_URL: https://sandbox.monnify.com for testing, https://api.monnify.com in production.
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
# Contract code identifies which of your Monnify wallets a transaction goes to.
MONNIFY_CONTRACT_CODE=

# --- Bachs (current default checkout processor — see GatewayPickerSheet.tsx) ---
# BACHS_BASE_URL: https://sandbox-api.bachs.io for testing, https://api.bachs.io in production.
BACHS_BASE_URL=https://sandbox-api.bachs.io
BACHS_SECRET_KEY=
# Signing secret shown once when the webhook endpoint is created in the Bachs
# developer portal (Webhooks section) — subscribe it to collection.succeeded,
# collection.failed, and collection.underpaid, pointed at /api/webhooks/bachs.
BACHS_WEBHOOK_SECRET=

# --- LiveKit Cloud (Xoldout Live's video layer — lib/live/liveKit.ts) ---
# Create a project at https://cloud.livekit.io — LIVEKIT_URL is the wss://
# URL shown on the project's Settings page; API key/secret are generated
# there too. No egress/recording is ever started (Lives aren't saved), so
# the free tier's participant-minutes are the only cost driver to watch.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Resend (order/ticket confirmation emails) ---
# xoldout.app is verified in Resend, so noreply@xoldout.app can deliver
# to any address. Fall back to "XOLDOUT <onboarding@resend.dev>" (Resend's
# shared sandbox domain) if you don't have a verified domain in your own
# Resend account — it can only deliver to the email on that account.
RESEND_API_KEY=
EMAIL_FROM="XOLDOUT <noreply@xoldout.app>"

# --- Internal ---
# Authenticates the GET /api/internal/sweep-holds and settle-ledger cron
# endpoints. Vercel auto-attaches this as `Authorization: Bearer` on
# requests it triggers via vercel.json's `crons` (must be named exactly
# CRON_SECRET for that auto-injection to happen) — set it here too for
# manual/local testing with the same header.
CRON_SECRET=
# Authenticates POST /api/internal/apk-release — sent as `Authorization:
# Bearer` by mobile's `npm run publish-apk` script (mobile/scripts/
# publish-apk.mjs), which also needs the R2_* vars above to upload the built
# APK itself before calling this route with just the resulting metadata.
APK_RELEASE_SECRET=
